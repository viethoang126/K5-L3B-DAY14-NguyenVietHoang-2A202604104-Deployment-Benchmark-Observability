# Dùng: cp .env.example .env rồi điền giá trị. KHÔNG commit file .env.
PORT=8000
ENVIRONMENT=development

# Secret: để trống ở đây. Tạo key bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# docker compose tự ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0

# Số uvicorn worker trong Docker
WEB_CONCURRENCY=2
